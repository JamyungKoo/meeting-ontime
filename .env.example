# [필수] Google Calendar iCal 비공개 주소
# 발급: 캘린더 → ⚙️ Settings → "내 캘린더의 설정" → 본인 사용자 이름 클릭
#       → "iCal 형식의 비공개 주소"(Secret address in iCal format) 복사
# 형식: https://calendar.google.com/calendar/ical/<이메일>/private-<토큰>/basic.ics
# 주의: 이 주소는 링크만 알면 캘린더를 볼 수 있는 비밀 URL입니다. 유출 금지.
ICS_URL=

# 미팅 시작 몇 초 전에 열지 (기본 60초 = 1분 전)
LEAD_SECONDS=60

# true면 카메라/마이크를 끈 뒤 참여 버튼까지 자동 클릭
# false면 참여 대기 화면(카메라/마이크 꺼진 상태)까지만 열어둠
AUTO_JOIN=true

# 관리 페이지 포트
PORT=5959
